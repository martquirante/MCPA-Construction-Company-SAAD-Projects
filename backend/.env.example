# =============================================================================
# MCPA CONSTRUCTION AND SUPPLY - BACKEND ENVIRONMENT CONFIGURATION
# Dual-Cloud Failover: Supabase (Primary) + Neon (Hot Standby & Auto-Sync)
# =============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (POSTGRESQL)
# -----------------------------------------------------------------------------
# Primary Database: Supabase PostgreSQL (Source of Truth)
SUPABASE_CONNECTION_STRING=postgres://postgres:[YOUR_DB_PASSWORD]@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Standby Backup Database: Neon Serverless PostgreSQL (Auto-synced from Supabase)
NEON_CONNECTION_STRING=postgres://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/[DBNAME]?sslmode=require

# Local Docker Development & Testing (Set to true to isolate testing locally in Docker)
USE_LOCAL_DB=false
LOCAL_DB_CONNECTION=postgres://postgres:postgres_local_password@localhost:5432/mcpa_dev_db

# Background Auto-Sync Settings (Supabase -> Neon)
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MS=300000

# -----------------------------------------------------------------------------
# 2. CLOUD STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Tier 1 Primary: Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=mcpastorage;AccountKey=YOUR_AZURE_ACCOUNT_KEY;EndpointSuffix=core.windows.net
AZURE_CONTAINER_PORTFOLIO=mcpa-portfolio
AZURE_CONTAINER_BRIEFS=mcpa-briefs

# Tier 2 Backup: Supabase Storage
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_PORTFOLIO=portfolio
SUPABASE_BUCKET_BRIEFS=briefs

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 4. EMAIL SERVICE (OTP DELIVERY)
# -----------------------------------------------------------------------------
# Primary: Gmail SMTP
# Generate an App Password in your Google Account (Security -> 2-Step Verification -> App Passwords)
SMTP_EMAIL=YOUR_EMAIL@gmail.com
SMTP_APP_PASSWORD=YOUR_16_CHAR_GMAIL_APP_PASSWORD
SMTP_HOST=
SMTP_PORT=587

# Backup: Resend API (Automatic fallback when Gmail SMTP fails)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Option B: Microsoft Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_EMAIL=your_email@outlook.com
# SMTP_APP_PASSWORD=your_password

# Option C: Yahoo Mail:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465 (or 587)
# SMTP_EMAIL=your_email@yahoo.com
# SMTP_APP_PASSWORD=your_yahoo_app_password

# -----------------------------------------------------------------------------
# 5. TRANSLATION API
# -----------------------------------------------------------------------------
# Preferred: Google Cloud Translation API
GOOGLE_TRANSLATE_API_KEY=

# Local free LibreTranslate endpoint (Docker: http://libretranslate:5000/translate;
# direct Node backend: http://localhost:5001/translate)
TRANSLATION_API_URL=http://localhost:5001/translate
TRANSLATION_API_KEY=

# Free fallback provider (used when Google and LibreTranslate are unset)
MYMEMORY_API_URL=https://api.mymemory.translated.net/get
